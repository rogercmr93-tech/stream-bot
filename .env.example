# Solo para uso local. En GitHub Actions estos valores van en "Secrets".
# Copia este archivo a .env y rellénalo

# Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick (https://kick.com/settings/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Segundos entre revisiones (solo en modo bucle continuo)
CHECK_INTERVAL=60
